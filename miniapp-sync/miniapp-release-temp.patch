--- a/app.wxss
+++ b/app.wxss
@@ -202,3 +202,60 @@ page {
   font-size: 24rpx;
   color: #8a5a1a;
 }
+
+/* 连接诊断：真机排查时要把原始 errMsg 完整露出来，因此允许换行 */
+.diag-url {
+  max-width: 60%;
+  text-align: right;
+  word-break: break-all;
+  font-size: 22rpx;
+  color: #5b616b;
+}
+
+.diag-box {
+  background: #fef2f2;
+  border: 2rpx solid #fbd5d5;
+  border-radius: 12rpx;
+  padding: 20rpx;
+  margin-top: 8rpx;
+}
+
+.diag-title {
+  font-size: 24rpx;
+  color: #b42318;
+  font-weight: 600;
+  margin-bottom: 12rpx;
+}
+
+.diag-raw {
+  font-size: 24rpx;
+  color: #1c1f23;
+  word-break: break-all;
+  line-height: 1.5;
+  margin-bottom: 12rpx;
+  font-family: 'SF Mono', Menlo, Consolas, monospace;
+}
+
+.diag-hint {
+  font-size: 24rpx;
+  color: #8a5a1a;
+  line-height: 1.6;
+}
+
+/* 首页的同步异常提示：连不上时必须说清原因，不能只显示「连接中」 */
+.sync-hint {
+  background: #fff7ed;
+  border-radius: 12rpx;
+  padding: 18rpx;
+  font-size: 24rpx;
+  color: #8a5a1a;
+  line-height: 1.6;
+  margin-bottom: 16rpx;
+}
+
+.sync-hint-link {
+  display: block;
+  margin-top: 12rpx;
+  color: #2f6bff;
+  font-size: 24rpx;
+}
